server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # This is intentionally a separate document from index.html. It is reached
    # only through a short-lived WhatsApp boundary capability token and always
    # receives a build-specific Flutter bootstrap.
    location = /whatsapp-farm-boundary {
        rewrite ^ /whatsapp-boundary.html last;
    }

    location = /whatsapp-boundary.html {
        internal;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Clear-Site-Data "\"cache\"" always;
        try_files $uri =404;
    }

    location = /whatsapp-boundary-bootstrap.js {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location = /whatsapp-service {
        rewrite ^ /whatsapp-service.html last;
    }

    location = /whatsapp-service.html {
        internal;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Clear-Site-Data "\"cache\"" always;
        try_files $uri =404;
    }

    location = /whatsapp-service-bootstrap.js {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    location ~ ^/(?:flutter_bootstrap\.js|flutter\.js|main\.dart\.js|flutter_service_worker\.js|version\.json|manifest\.json)$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    location ~* \.(?:css|js|json|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri /index.html;
    }
}
